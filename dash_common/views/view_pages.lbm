; The swappable lower area of the screen.
;
; Same contract as the other dashes in this family: page-catalog holds the
; selectable pages, settings-page-mask picks which are in rotation, and the
; settings page is always last. A page function is called with s = true on the
; pass it becomes visible, which is when it draws its static labels and
; allocates its image buffers; on later passes it only redraws fields whose
; value changed.

; Which row the settings list is scrolled to. Lives outside the const block
; because it is written at runtime.
(def settings-first-row-last -1)

; How faded the session page is drawn, 0 to 1, tracked so a change forces the
; values to be repainted.
(def page-session-fade 0.0)

@const-start

; page-x/y/w/h and page-row-h come from view_static, which owns the layout.
(def row-h page-row-h)

; Was a bitmap of a solid rectangle in the smaller dashes
(defun page-clear () {
        (var strip (img-buffer dm-pool 'indexed2 page-w 4))
        (looprange i 0 (/ page-h 4)
            (disp-render strip page-x (+ page-y (* i 4)) (list color-bg color-bg)))
})

; Round with decimals. E.g. (round-x 1.23 0.1) -> 1.2
(defun round-x (val x) (* (round (/ val x)) x))

(defun trunc01 (x)
    (cond
        ((< x 0.0) 0.0)
        ((> x 1.0) 1.0)
        (t x)
))

; Association list of buffers allocated for the visible page. Rebinding it on
; a page switch lets GC reclaim the previous page's buffers.
(def page-resources nil)

(defun txt-right (imgbuf x y str) {
        (var color (if (rest-args) (rest-args 0) colors-text-aa))
        (var (w-txt h-txt) (ttf-text-dims font-24 str))
        (var (w-img h-img) (img-dims imgbuf))
        (img-clear imgbuf)
        (ttf-text imgbuf (- w-img w-txt) 22 '(0 1 2 3) font-24 str)
        (disp-render imgbuf x y color)
})

(defun txt-left (imgbuf x y str) {
        (var color (if (rest-args) (rest-args 0) colors-text-aa))
        (img-clear imgbuf)
        (ttf-text imgbuf 0 22 '(0 1 2 3) font-24 str)
        (disp-render imgbuf x y color)
})

; A label/value grid of page-cols columns. Every text page supplies eight
; cells, so the rows per column follow from the column count: a square panel
; gets 2x4, a wide one 4x2, and no page has to know which.
(def page-rows (/ 8 page-cols))
(def col-w (/ page-w page-cols))
(def col-gap 12)
; Labels are right-aligned into their share of the column and values start a
; fixed gap later, so the two never run together.
(def col-lbl-w (/ (* col-w 5) 8))
(def col-val-w (- col-w col-lbl-w col-gap))

(defun grid-col-x (i) (+ page-x (* (/ i page-rows) col-w)))
(defun grid-lbl-x (i) (grid-col-x i))
(defun grid-val-x (i) (+ (grid-col-x i) col-lbl-w col-gap))
(defun grid-y (i) (+ page-y (* (mod i page-rows) row-h)))

; Draws the eight static labels of a two-column page
(defun grid-labels (labels) {
        (var lblimg (img-buffer dm-pool 'indexed4 col-lbl-w row-h))
        (looprange i 0 (length labels)
            (txt-right lblimg (grid-lbl-x i) (grid-y i) (ix labels i)))
})

(defun grid-values (update strs)
    (grid-values-col update colors-text-aa strs))

; As grid-values, but in a given colour, so a page can fade itself.
(defun grid-values-col (update col strs) {
        (var valimg (assoc page-resources 'val-img))
        (looprange i 0 (length strs)
            (if (ix update i)
                (txt-left valimg (grid-val-x i) (grid-y i) (ix strs i) col)))
})

; --- Live page: four configurable slots, 2x2 ------------------------------

; A slot is a number unless it is one of the timers, which read as a duration.
; A timer is never smoothed: it only counts up, so there is nothing to glide
; towards, and a smoothed clock would read the wrong time.
(defun slot-str (i) {
        (var src (ix settings-slots i))
        (if (slot-is-time src)
            (slot-time-str (slot-value src))
            (str-from-n (slot-shown i) (slot-fmt src)))
})

(defun get-page-live-state () (list
        (slot-str 0) (slot-str 1) (slot-str 2) (slot-str 3)
))

(def page-live-state (get-page-live-state))

; (cell progress) of the hold last drawn, so the cell redraws as it fills.
(def page-live-hold (list nil 0.0))

; How a live cell is coloured. Mode 0 is its own fixed colour; the rest are
; rules over where the value sits in the cell's min..max range. Mode order is
; stored in eeprom, so only append.
;
;   0 fixed     the slot colour
;   1 ramp      green, then amber from 0.6, then red from 0.85
;   2 heat      teal to red, continuous, from a prebuilt 16-step table
;   3 low-warn  the ramp read the other way: red at the bottom of the range,
;               which is what a state of charge or a pack voltage wants
;   4 sign      accent while the value is positive, green while it is negative,
;               so regen on power or current reads at a glance
(defun slot-colors (i) {
        (var mode (ix settings-slot-modes i))
        (if (= mode 0) (ix colors-slots i) {
                (var lo (ix settings-slot-mins i))
                (var hi (ix settings-slot-maxs i))
                ; The shown value, not the raw one, so the colour cannot
                ; disagree with the number beside it while it is gliding.
                ; slot-str runs first each frame, so this reads the step it
                ; already took rather than taking another.
                (var v (ix stats-slot-smooth i))
                (if (or (eq v nil) (<= settings-smooth 0.0))
                    (setq v (to-float (slot-value (ix settings-slots i)))))
                (var f (if (<= hi lo) 0.0 (/ (- v lo) (- hi lo))))
                (cond
                    ((= mode 2) (colors-heat-ramp f))
                    ((= mode 3) (cond
                            ((< f 0.15) colors-crit)
                            ((< f 0.4) colors-warn)
                            (t colors-ok)))
                    ((= mode 4) (if (< v 0.0) colors-ok colors-accent-aa))
                    (t (cond
                            ((> f 0.85) colors-crit)
                            ((> f 0.6) colors-warn)
                            (t colors-ok)))
                )
        })
})

; The four slots follow the page grid rather than always being 2x2: a wide
; panel lays them in one row, a square one in two. A 2x2 on the short page
; area a wide panel leaves would overflow the nav strip.
(def live-cols (if (>= page-cols 4) 4 2))
(def live-rows (/ 4 live-cols))
(def live-cell-w (/ page-w live-cols))
(def live-cell-h (/ page-h live-rows))
(def live-lbl-h 24)
(def live-val-h 46)

(defun live-cell-x (i) (+ page-x (* (mod i live-cols) live-cell-w) 8))
(defun live-cell-y (i) (+ page-y (* (/ i live-cols) live-cell-h)))

; Which live cell a screen coordinate falls in, or nil for none. The inverse of
; live-cell-x / live-cell-y, derived from the same three numbers, so it follows
; whatever grid the board profile produced rather than assuming a 2x2. The 8 px
; live-cell-x adds is padding inside the cell and not a gap between cells, so it
; is not subtracted back out here.
;
; Integer division truncates towards zero, so a coordinate above or left of the
; page area would land in cell 0; both edges are tested explicitly. Below the
; grid needs no test of its own: the nav strip starts 4 px past the last row, so
; a press there gives a row index of live-rows and falls out.
(defun live-cell-hit (x y) {
        (var cx (/ (- x page-x) live-cell-w))
        (var cy (/ (- y page-y) live-cell-h))
        (if (or (< x page-x) (< y page-y)
                (>= cx live-cols) (>= cy live-rows))
            nil
            (+ (* cy live-cols) cx))
})

; The cell currently under a finger that is being held, or nil. btn-hold-region
; is nil unless something is held, which is what keeps this from reporting the
; last place touched.
(defun live-hold-cell ()
    (if btn-hold-region (live-cell-hit touch-x touch-y) nil))

; A held cell's value drifts from the text colour towards the accent colour as
; the hold fills, which is the affordance for the long press that sends that
; cell to the chart page. The session page fades towards the background for the
; opposite reason -- there the hold destroys the value.
(defun slot-hold-colors (f)
    (colors-make-aa color-bg (color-mix color-text color-accent (clamp01 f)) 4))

(defun page-live (s) {
        ; Entering the page snaps rather than gliding up from whatever was
        ; shown when it was last open, which could be minutes stale.
        (if s (slot-smooth-reset))

        (var curr-state (get-page-live-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-live-state curr-state))

        ; A ramped slot can change colour while its text does not
        (looprange i 0 4
            (if (= (ix settings-slot-modes i) 1) (setix update-state i true)))

        ; The held cell, and the one that was held a frame ago, both have to be
        ; redrawn even when their text has not changed: one takes the hold
        ; colour and the other has to lose it.
        (var hold (live-hold-cell))
        (var hold-f (if hold btn-hold-progress 0.0))
        (if (not-eq (list hold hold-f) page-live-hold) {
                (if (first page-live-hold)
                    (setix update-state (first page-live-hold) true))
                (if hold (setix update-state hold true))
                (setq page-live-hold (list hold hold-f))
        })

        (if s {
                (setq update-state (map (fn (x) t) curr-state))

                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 (- live-cell-w 16) live-val-h))
                ))

                (page-clear)

                (var lblimg (img-buffer dm-pool 'indexed4 (- live-cell-w 16) live-lbl-h))
                (looprange i 0 4 {
                        (var src (ix settings-slots i))
                        (img-clear lblimg)
                        (ttf-text lblimg 4 18 '(0 1 2 3) font-16
                            (str-merge (slot-label src) "  " (slot-unit src)))
                        (disp-render lblimg (live-cell-x i) (+ (live-cell-y i) 2)
                            colors-text-aa)
                })
        })

        (var valimg (assoc page-resources 'val-img))
        (looprange i 0 4
            (if (ix update-state i) {
                    (img-clear valimg)
                    (ttf-text valimg 8 36 '(0 1 2 3) font-40 (ix curr-state i))
                    (disp-render valimg (live-cell-x i)
                        (+ (live-cell-y i) live-lbl-h 2)
                        (if (eq hold i) (slot-hold-colors hold-f) (slot-colors i)))
            })
        )

        (setq page-live-state curr-state)
})

; --- Trip page -------------------------------------------------------------

(defun get-page-trip-state () (list
        ; Ride-average consumption, not the instantaneous figure: coasting
        ; drives the latter to zero and the range estimate to infinity.
        (round-x (if (and (> stats-km 0.1) (> stats-wh 0.5))
                     (/ (* stats-battery-ah (batt-soc) stats-vin)
                        (/ stats-wh stats-km))
                     0.0) 0.1)               ; 0 Range
        (round-x stats-km 0.1)               ; 1 Trip
        (round-x stats-odom 0.1)             ; 2 ODO
        (round-x (if (> stats-km 0.1) (/ stats-wh stats-km) 0) 0.1) ; 3 Efficiency
        (round-x stats-wh 0.1)               ; 4 Energy
        (round-x stats-wh-chg 0.1)           ; 5 Regen
        (round-x stats-battery-ah 0.1)       ; 6 Amp hours
        (round-x stats-vin 0.1)              ; 7 Voltage
))

(def page-trip-state (get-page-trip-state))

(defun page-trip (s) {
        (var curr-state (get-page-trip-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-trip-state curr-state))

        (if s {
                (setq update-state (map (fn (x) t) curr-state))
                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 col-val-w row-h))
                ))
                (page-clear)
                (grid-labels (list "Range" "Trip" "ODO" "Efficiency"
                                   "Energy" "Regen" "Amp Hours" "Voltage"))
        })

        (grid-values update-state (list
            (str-from-n (u-dist (ix curr-state 0)) "%.1f")
            (str-from-n (u-dist (ix curr-state 1)) "%.1f")
            (str-from-n (u-dist (ix curr-state 2)) "%.0f")
            (str-from-n (/ (ix curr-state 3)
                           (if (eq (car settings-units-speeds) 'mph) km-to-mi 1.0)) "%.0f")
            (str-from-n (ix curr-state 4) "%.0f")
            (str-from-n (ix curr-state 5) "%.0f")
            (str-from-n (ix curr-state 6) "%.1f")
            (str-from-n (ix curr-state 7) "%.1f")
        ))

        (setq page-trip-state curr-state)
})

; --- Session page: maxima and totals since the last reset ------------------

(defun get-page-session-state () (list
        (round (secs-since 0))               ; 0 Time
        (round (u-speed stats-kmh-max))      ; 1 Speed max
        (round (* stats-kw-max 1000.0))      ; 2 Power max
        (round-x stats-amps-now-max 0.1)     ; 3 Current max
        (round (u-temp stats-temp-motor-max)); 4 Motor temp max
        (round (u-temp stats-temp-esc-max))  ; 5 ESC temp max
        (round (u-temp stats-temp-battery-max)) ; 6 Pack temp max
        (round-x stats-duty 0.01)            ; 7 Duty
))

(def page-session-state (get-page-session-state))

; Which touch region resets the session. btn-actions-long holds an action id
; per region; 12 is "reset the session maxima". Whichever region is bound to
; it is the one whose hold should fade this page.
(defun session-reset-region () (list-find btn-actions-long 12))

(defun page-session (s) {
        (var curr-state (get-page-session-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-session-state curr-state))

        ; While that region is held, every value on the page fades towards the
        ; background in step with the hold, and comes back if you let go.
        (var rst (session-reset-region))
        (var fade (if (and rst btn-hold-region (= btn-hold-region rst))
                      btn-hold-progress 0.0))
        (if (not-eq fade page-session-fade) {
                (setq page-session-fade fade)
                (setq update-state (map (fn (x) t) curr-state))
        })

        (if s {
                (setq update-state (map (fn (x) t) curr-state))
                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 col-val-w row-h))
                ))
                (page-clear)
                (grid-labels (list "Time" "Speed Max" "Power Max" "I Max"
                                   "T Mot Max" "T ESC Max" "T Pack Max" "Duty"))
        })

        (var secs (to-i (ix curr-state 0)))
        (grid-values-col update-state (colors-fade-aa page-session-fade) (list
            (slot-time-str secs)
            (str-from-n (ix curr-state 1) "%.0f")
            (str-from-n (ix curr-state 2) "%.0f")
            (str-from-n (ix curr-state 3) "%.0f")
            (str-from-n (ix curr-state 4) "%.0f")
            (str-from-n (ix curr-state 5) "%.0f")
            (str-from-n (ix curr-state 6) "%.0f")
            (str-from-n (* 100.0 (ix curr-state 7)) "%.0f")
        ))

        (setq page-session-state curr-state)
})

; --- Battery page ----------------------------------------------------------

(defun get-page-batt-state () (list
        (round-x (get-bms-val 'bms-v-tot) 0.1)      ; 0
        (round-x (get-bms-val 'bms-v-cell-min) 0.01); 1
        (round-x (get-bms-val 'bms-v-cell-max) 0.01); 2
        (get-bms-val 'bms-cell-num)                 ; 3
        (round-x (get-bms-val 'bms-i-in-ic) 0.1)    ; 4
        (round-x (get-bms-val 'bms-ah-cnt) 0.01)    ; 5
        (round (get-bms-val 'bms-temp-cell-max))    ; 6
        (round (get-bms-val 'bms-hum))              ; 7
))

(def page-batt-state (get-page-batt-state))

(defun page-batt (s) {
        ; The BMS values all read zero with nothing connected, which is
        ; indistinguishable from a real reading, so say so outright.
        (var curr-state (if battery-a-connected
                            (get-page-batt-state)
                            (map (fn (x) 0) (range 8))))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-batt-state curr-state))

        (if s {
                (setq update-state (map (fn (x) t) curr-state))
                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 col-val-w row-h))
                ))
                (page-clear)

                (if (not battery-a-connected) {
                        (var imgbuf (img-buffer dm-pool 'indexed4 page-w 30))
                        (img-clear imgbuf)
                        (ttf-txt-center "No BMS on the bus" font-24 imgbuf)
                        (disp-render imgbuf page-x (+ page-y 58) colors-dim-icon)
                }
                (grid-labels (list "Pack V" "Cell Min" "Cell Max" "Cells"
                                   "Current" "Ah Count" "T Cell Max" "Humidity")))
        })

        (if battery-a-connected
            (grid-values update-state (list
                (str-from-n (ix curr-state 0) "%.1f")
                (str-from-n (ix curr-state 1) "%.2f")
                (str-from-n (ix curr-state 2) "%.2f")
                (str-from-n (ix curr-state 3) "%d")
                (str-from-n (ix curr-state 4) "%.1f")
                (str-from-n (ix curr-state 5) "%.2f")
                (str-from-n (ix curr-state 6) "%.0f")
                (str-from-n (ix curr-state 7) "%.0f")
            ))
        )

        (setq page-batt-state curr-state)
})

; --- Settings page ---------------------------------------------------------

(def settings-rows-visible (/ page-h row-h))

; LBM has no min
(defun imin (a b) (if (< a b) a b))

(defun get-page-settings-state () (append
        (map (fn (n) (read-setting n)) setting-list-page1)
        (list setting-now)
))

(def page-settings-state (get-page-settings-state))

(defun page-settings (s) {
        (var rows (length setting-list-page1))
        (var curr-state (get-page-settings-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-settings-state curr-state))

        ; The list is taller than the page, so it scrolls. Which rows are on
        ; screen depends on the selection, so a selection move has to redraw
        ; the labels too, not just the values.
        (var first-row (cond
                ((<= rows settings-rows-visible) 0)
                ((< setting-now (/ settings-rows-visible 2)) 0)
                ((>= setting-now (- rows (/ settings-rows-visible 2)))
                    (- rows settings-rows-visible))
                (t (- setting-now (/ settings-rows-visible 2)))
        ))

        (if (or s (not-eq first-row settings-first-row-last)) {
                (setq update-state (map (fn (x) t) curr-state))
                (setq settings-first-row-last first-row)

                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 (- page-w 224) row-h))
                ))

                (page-clear)

                (var lblimg (img-buffer dm-pool 'indexed4 210 row-h))
                (looprange i 0 (imin settings-rows-visible rows)
                    (txt-right lblimg (+ page-x 4) (+ page-y (* i row-h))
                        (ix setting-label-page1 (+ first-row i))))
        })

        (var valimg (assoc page-resources 'val-img))
        (looprange i 0 (imin settings-rows-visible rows) {
                (var r (+ first-row i))
                (if (or (ix update-state r) (ix update-state rows))
                    (txt-left valimg (+ page-x 224) (+ page-y (* i row-h))
                        (str-from-n (ix curr-state r) (ix setting-fmt-page1 r))
                        (if (= (ix curr-state rows) r) colors-text-sel-aa colors-text-aa))
                )
        })

        (setq page-settings-state curr-state)
})

; --- Controller settings page ------------------------------------------------
;
; Same shape as the display settings page, but the values live on the
; controller: they are mirrored in over CAN and changed by sending a frame back,
; so a row reads nil until the controller has reported it.

(def conf-first-row-last -1)

(defun get-page-conf-state () (append
        (map (fn (i) (let ((v (conf-value i)))
                         (if (eq v nil) "--" (str-from-n v (ix (conf-row i) 2)))))
             (range (conf-menu-len)))
        (list conf-now conf-dirty kill-sw-active)
))

(def page-conf-state (get-page-conf-state))

(defun page-conf (s) {
        (var rows (conf-menu-len))
        (var curr-state (get-page-conf-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-conf-state curr-state))

        (var first-row (cond
                ((<= rows settings-rows-visible) 0)
                ((< conf-now (/ settings-rows-visible 2)) 0)
                ((>= conf-now (- rows (/ settings-rows-visible 2)))
                    (- rows settings-rows-visible))
                (t (- conf-now (/ settings-rows-visible 2)))
        ))

        ; The labels move when the list scrolls, and a gated row changes
        ; appearance when the kill switch does, so both force a full redraw.
        (if (or s (not-eq first-row conf-first-row-last)
                (ix update-state (+ rows 2))) {
                (setq update-state (map (fn (x) t) curr-state))
                (setq conf-first-row-last first-row)

                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 (- page-w 224) row-h))
                ))

                (page-clear)

                (var lblimg (img-buffer dm-pool 'indexed4 210 row-h))
                (looprange i 0 (imin settings-rows-visible rows) {
                        (var r (+ first-row i))
                        ; A gated row the kill switch is not holding is shown
                        ; dim, so it is clear before pressing that it will be
                        ; refused rather than after.
                        (txt-right lblimg (+ page-x 4) (+ page-y (* i row-h))
                            (str-merge (ix (conf-row r) 1)
                                       (if (conf-blocked r) " *" "")))
                })
        })

        (var valimg (assoc page-resources 'val-img))
        (looprange i 0 (imin settings-rows-visible rows) {
                (var r (+ first-row i))
                (if (or (ix update-state r) (ix update-state rows))
                    (txt-left valimg (+ page-x 224) (+ page-y (* i row-h))
                        (ix curr-state r)
                        (cond
                            ((conf-blocked r) (colors-fade-aa 0.45))
                            ((= (ix curr-state rows) r) colors-text-sel-aa)
                            (t colors-text-aa)))
                )
        })

        (setq page-conf-state curr-state)
})

; --- PAS page: what the rider is contributing and what the motor adds -------

; Rounded so that the page only redraws when a displayed digit changes, rather
; than on every sample of a noisy torque signal.
(defun get-page-pas-state () (list
        (round stats-pas-cadence)                    ; 0 Cadence
        (round-x stats-pas-torque 0.1)               ; 1 Crank torque
        (round stats-pas-rider-w)                    ; 2 Rider power
        (round stats-pas-assist-w)                   ; 3 Assist power
        (round-x (slot-value 29) 0.1)                ; 4 Assist multiple
        (round (* stats-pas-output 100.0))           ; 5 Output
        (round (u-speed stats-kmh))                  ; 6 Speed
        stats-pas-flags                              ; 7 Status
))

(def page-pas-state (get-page-pas-state))

; The flag bits are the ones app_pas_get_flags reports. Only the most
; significant one is shown, since there is a single field for it, and the order
; here is worst first.
;
; Kept to five characters. The grid sizes the value column for a number, and on
; a four column panel anything longer is cut off mid-word: a demo render of the
; speed limited state came out as "sp lim". The pas_status terminal command
; spells each of these out in full.
(defun pas-status-str (flags)
    (cond
        ((not stats-pas-rx) "no rx")
        ((!= 0 (bitwise-and flags 0x10)) "nopin")
        ((!= 0 (bitwise-and flags 0x02)) "trqch")
        ((!= 0 (bitwise-and flags 0x04)) "brkch")
        ((!= 0 (bitwise-and flags 0x20)) "sens")
        ((!= 0 (bitwise-and flags 0x40)) "notrq")
        ((!= 0 (bitwise-and flags 0x01)) "clip")
        ((!= 0 (bitwise-and flags 0x200)) "wlkch")
        ((!= 0 (bitwise-and flags 0x08)) "brake")
        ((!= 0 (bitwise-and flags 0x100)) "walk")
        ((!= 0 (bitwise-and flags 0x80)) "splim")
        (t "ok")
))

(defun page-pas (s) {
        (var curr-state (get-page-pas-state))
        (var update-state (zipwith (fn (x y) (not-eq x y)) page-pas-state curr-state))

        (if s {
                (setq update-state (map (fn (x) t) curr-state))
                (setq page-resources (list
                        (cons 'val-img (img-buffer dm-pool 'indexed4 col-val-w row-h))
                ))
                (page-clear)
                (grid-labels (list "Cadence" "Crank Trq" "Rider" "Assist"
                                   "Assist x" "Output" "Speed" "Status"))
        })

        (grid-values update-state (list
            (str-from-n (ix curr-state 0) "%.0f")
            (str-from-n (ix curr-state 1) "%.1f")
            (str-from-n (ix curr-state 2) "%.0f")
            (str-from-n (ix curr-state 3) "%.0f")
            (str-from-n (ix curr-state 4) "%.1f")
            (str-from-n (ix curr-state 5) "%.0f")
            (str-from-n (ix curr-state 6) "%.0f")
            (pas-status-str (ix curr-state 7))
        ))

        (setq page-pas-state curr-state)
})

; --- Chart page: a rolling window of one live value --------------------------

; Geometry. The trace gets most of the page and the readouts sit under it.
(def chart-h (- page-h 2 row-h))
(def chart-y page-y)

; Redrawn only when a displayed number changes or a new sample has arrived,
; which is what keeps this off the redraw path the rest of the time.
(defun get-page-chart-state () (list
        chart-count                                  ; 0 a new sample
        settings-chart-src                           ; 1 source changed
        settings-chart-secs                          ; 2 window changed
))

(def page-chart-state (get-page-chart-state))

; The trace, autoscaled to what is in the window. A flat line is centred rather
; than filling the height, which is what dividing by a zero range would do.
(defun chart-draw (img w h n) {
        (if (< n 2) (return nil))

        (var lo (chart-at 0))
        (var hi lo)
        (looprange i 0 n {
                (var v (chart-at i))
                (if (< v lo) (setq lo v))
                (if (> v hi) (setq hi v))
        })

        (var span (- hi lo))
        (var flat (< span 0.0001))

        ; Oldest on the left, newest on the right.
        (var x-pre 0)
        (var y-pre 0)
        (looprange i 0 n {
                (var v (chart-at (- n 1 i)))
                (var f (if flat 0.5 (map-range-01 v lo hi)))
                (var x (/ (* i (- w 1)) (- n 1)))
                (var y (- h 2 (to-i (* f (- h 4)))))
                (if (> i 0) (img-line img x-pre y-pre x y 1 '(thickness 2)))
                (setq x-pre x)
                (setq y-pre y)
        })

        (list lo hi)
})

(defun page-chart (s) {
        (var curr-state (get-page-chart-state))

        (if s {
                (setq page-resources (list
                        (cons 'chart-img (img-buffer dm-pool 'indexed2 page-w chart-h))
                        (cons 'chart-txt (img-buffer dm-pool 'indexed4 page-w row-h))
                ))
                (page-clear)
        })

        (var n (chart-window))
        (var img (assoc page-resources 'chart-img))
        (img-clear img)
        (var bounds (chart-draw img page-w chart-h n))
        (disp-render img page-x chart-y (list color-bg color-accent))

        ; Source, window, and what the trace spans. The newest sample is the
        ; right hand edge, so it is the same number a live cell would show.
        (var txt (assoc page-resources 'chart-txt))
        (img-clear txt)
        (var unit (slot-unit settings-chart-src))

        ; ttf-text takes a baseline, not a top edge, so a y of zero draws the
        ; line entirely above the buffer and nothing appears at all. Centred
        ; the way ttf-txt-center does it, from the glyph height, so it holds
        ; for whatever row height a board profile uses.
        (var (gw gh) (ttf-glyph-dims font-16 "D"))
        (var by (+ gh (/ (- row-h gh) 2)))

        (ttf-text txt 4 by '(0 1 2 3) font-16
            (str-merge (slot-label settings-chart-src)
                       (str-from-n settings-chart-secs "  %d s")))

        ; Named bounds, not range: range is an LBM builtin, and binding it is
        ; accepted while reading it back fails with "cannot redefine built-in".
        (var info (if bounds
                      (str-merge (str-from-n (ix bounds 0) "%.1f")
                                 " to "
                                 (str-from-n (ix bounds 1) "%.1f")
                                 " " unit)
                      "collecting"))
        (var (iw ih) (ttf-text-dims font-16 info))
        (ttf-text txt (- page-w iw 4) by '(0 1 2 3) font-16 info)
        (disp-render txt page-x (+ chart-y chart-h 2) colors-text-aa)

        (setq page-chart-state curr-state)
})

; Index order is stored in settings-page-mask, so only append here.
(def page-catalog
    (list page-live page-trip page-session page-batt page-pas page-chart
          page-conf))

(def pages (append page-catalog (list page-settings)))

(defun settings-apply-pages () {
        (var sel nil)
        (looprange i 0 (length page-catalog)
            (if (!= 0 (bitwise-and settings-page-mask (shl 1 i)))
                (setq sel (cons (ix page-catalog i) sel))
        ))
        (setq sel (reverse sel))

        (if (eq sel nil) (setq sel (list (ix page-catalog 0))))

        (setq page-num (length sel))
        (setq pages (append sel (list page-settings)))
        (if (> page-now page-num) (setq page-now 0))
})

(settings-apply-pages)

(defun view-pages-thread () {
        (var last-page 100)	; forces s = true on the first pass

        (loopwhile t {
                (var page-now-sample page-now)
                (var curr-page (ix pages page-now-sample))
                (var force view-force-pages)
                (setq view-force-pages false)
                (if curr-page (curr-page (or force (not (= last-page page-now-sample)))))
                (setq last-page page-now-sample)
                (sleep 0.05)
        })
})

@const-end
